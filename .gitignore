# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/
jspm_packages/
bower_components/

# ─────────────────────────────────────────────
# Environment variables (SECRET — never commit)
# ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────
# Runtime data
# ─────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ─────────────────────────────────────────────
# Coverage / test output
# ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
lib-cov/

# ─────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────
build/
dist/
out/
.next/
.cache/
.parcel-cache/

# ─────────────────────────────────────────────
# Uploads (user-generated content)
# ─────────────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ─────────────────────────────────────────────
# Database / backups
# ─────────────────────────────────────────────
*.sql.bak
*.sqlite
*.sqlite3
*.db
db_backup_*/
src_backup_*/
src_backup*/
**/backup_*/
*.dump

# ─────────────────────────────────────────────
# OS files
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────
# Editor / IDE
# ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.c9/
*.launch
.settings/

# ─────────────────────────────────────────────
# Temporary folders / caches
# ─────────────────────────────────────────────
tmp/
temp/
.tmp/
.temp/
.cache/
node_modules/.cache/
.eslintcache
.stylelintcache

# ─────────────────────────────────────────────
# Prettier / ESLint
# ─────────────────────────────────────────────
.prettiercache
.eslintcache

# ─────────────────────────────────────────────
# Misc
